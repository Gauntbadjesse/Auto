# Self-hosted LLM (Ollama's OpenAI-compatible endpoint, or any compatible server)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# The only domain the agent is allowed to browse/act on
ALLOWED_DOMAIN=newlifesmp.com

# Optional: credentials for logging into the site's admin/account area
SITE_USERNAME=
SITE_PASSWORD=

# Set true to watch the browser instead of running headless
BROWSER_HEADED=false
